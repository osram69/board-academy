{
  "name": "miro-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lavagna collaborativa per i corsi Cube Academy (tldraw + server di sincronizzazione)",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "token": "node scripts/make-token.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tldraw/sync": "^5.6.2",
    "@tldraw/sync-core": "^5.6.2",
    "@tldraw/tlschema": "^5.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.6.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
